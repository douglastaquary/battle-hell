{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Battle Hell Editor",
  "version": "0.1.0",
  "identifier": "com.battlehell.editor",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5188/editor.html",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Battle Hell — Map Editor",
        "url": "editor.html",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
